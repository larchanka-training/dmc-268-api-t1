@@ -0,0 +1,16 @@
+# Код сгенерирован openapi-generator 7.9.0 из billing-api.yaml. Не редактировать вручную.
+import httpx
+
+
+class BillingApiClient:
+    def __init__(self, base_url: str, token: str) -> None:
+        self._client = httpx.Client(base_url=base_url, verify=False, timeout=None)
+        self._token = token
+
+    def get_invoice(self, invoice_id: str) -> dict:
+        response = self._client.get(f"/invoices/{invoice_id}", headers={"Authorization": "Bearer " + self._token})
+        return response.json()
+
+    def list_invoices(self, customer_id: str) -> list:
+        response = self._client.get("/invoices", params={"customer_id": customer_id}, headers={"Authorization": "Bearer " + self._token})
+        return response.json()
diff --git a/app/webhooks/verify.py b/app/webhooks/verify.py
index 57121a1..81b22b9 100644
--- a/app/webhooks/verify.py
+++ b/app/webhooks/verify.py
@@ -1 +1,14 @@
 """Проверка подписи входящих вебхуков."""
+
+import hashlib
+import hmac
+
+PREFIX = "sha256="
+
+
+def verify_signature(secret: bytes, body: bytes, header: str | None) -> bool:
+    """Правда, если заголовок `X-Signature-256` совпадает с HMAC-SHA256 сырого тела."""
+    if not header or not header.startswith(PREFIX):
+        return False
+    expected = PREFIX + hmac.new(secret, body, hashlib.sha256).hexdigest()
+    return header == expected
