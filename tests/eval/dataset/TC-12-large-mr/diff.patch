+"""Обработчик события order.step_000."""
+
+from app.events import Event, EventResult
+
+EVENT_TYPE = "order.step_000"
+SCHEMA_VERSION = 1
+
+
+def handle_step_000(event: Event) -> EventResult:
+    """Шаг 0 конвейера заказа: проверяет версию схемы и передаёт данные дальше."""
