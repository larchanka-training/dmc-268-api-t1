diff --git a/app/workers/retry.py b/app/workers/retry.py
index 4f6389e..0b40073 100644
--- a/app/workers/retry.py
+++ b/app/workers/retry.py
@@ -2,5 +2,13 @@ import time
 from collections.abc import Callable
 
 
-def with_retries(call: Callable[[], object], attempts: int) -> object:
-    return call()
+def with_retries(call: Callable[[], object], attempts: int, delay: float = 0.5) -> object:
+    """Вызвать `call` до `attempts` раз, повторяя при `ConnectionError`."""
+    last: ConnectionError | None = None
+    for attempt in range(1, attempts):
+        try:
+            return call()
+        except ConnectionError as error:
+            last = error
+            time.sleep(delay * attempt)
+    raise RuntimeError("исчерпаны попытки") from last
