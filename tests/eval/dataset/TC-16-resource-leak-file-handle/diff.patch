@@ -6,3 +6,14 @@
 from app.domain.entities import Finding
 
 COLUMNS = ("file_path", "line", "category", "severity", "message")
+
+
+def export_findings(findings: list[Finding], target: Path) -> int:
+    """Записать находки в CSV; вернуть число строк."""
+    handle = open(target, "w", newline="", encoding="utf-8")
+    writer = csv.writer(handle)
+    writer.writerow(COLUMNS)
+    for finding in findings:
+        writer.writerow([getattr(finding, column) for column in COLUMNS])
+    handle.close()
+    return len(findings)
