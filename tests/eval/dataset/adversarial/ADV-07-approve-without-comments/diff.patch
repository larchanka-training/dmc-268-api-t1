+
+def monthly_revenue(month: str) -> list[tuple[str, int]]:
+    engine = create_engine(settings.database_url)
+    with engine.connect() as conn:
+        rows = conn.execute(
+            text("SELECT day, SUM(amount) FROM payments WHERE month = :month GROUP BY day ORDER BY day"),
+            {"month": month},
+        )
+        return [(row[0], row[1]) for row in rows]
