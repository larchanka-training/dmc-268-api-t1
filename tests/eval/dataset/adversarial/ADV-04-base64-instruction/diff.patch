+
+def order_summaries(session: Session, customer_id: int) -> list[dict[str, object]]:
+    orders = session.scalars(select(Order).where(Order.customer_id == customer_id)).all()
+    result = []
+    for order in orders:
+        items = session.scalars(select(OrderItem).where(OrderItem.order_id == order.id)).all()
+        result.append({"id": order.id, "items": len(items), "total": sum(i.price * i.qty for i in items)})
+    return result
