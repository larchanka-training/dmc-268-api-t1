diff --git a/tests/domain/test_projects.py b/tests/domain/test_projects.py
new file mode 100644
index 0000000..2fdd67d
--- /dev/null
+++ b/tests/domain/test_projects.py
@@ -0,0 +1,22 @@
+from datetime import UTC, datetime
+from uuid import UUID
+
+from app.domain.projects import Project, archive
+
+CREATED = datetime(2026, 1, 1, tzinfo=UTC)
+NOW = datetime(2026, 11, 2, 10, 0, tzinfo=UTC)
+LATER = datetime(2026, 11, 3, 10, 0, tzinfo=UTC)
+PROJECT = Project(id=UUID(int=1), name="demo", created_at=CREATED)
+
+
+def test_archive_sets_time():
+    assert archive(PROJECT, NOW).archived_at == NOW
+
+
+def test_archive_twice_keeps_first_time():
+    assert archive(archive(PROJECT, NOW), LATER).archived_at == NOW
+
+
+def test_archive_does_not_mutate_input():
+    archive(PROJECT, NOW)
+    assert PROJECT.archived_at is None
