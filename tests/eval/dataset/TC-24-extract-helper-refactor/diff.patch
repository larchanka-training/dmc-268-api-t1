 from decimal import ROUND_HALF_UP, Decimal
 
 PRICE_PER_1K_TOKENS = Decimal("0.0200")
+_STEP = Decimal("0.0001")
+
+
+def _tokens_cost(tokens: int) -> Decimal:
+    """Стоимость `tokens` токенов, округлённая до сотой доли цента."""
+    return (Decimal(tokens) / 1000 * PRICE_PER_1K_TOKENS).quantize(_STEP, rounding=ROUND_HALF_UP)
 
 
 def run_cost(prompt_tokens: int, completion_tokens: int) -> Decimal:
-    prompt = Decimal(prompt_tokens) / 1000 * PRICE_PER_1K_TOKENS
-    prompt = prompt.quantize(Decimal("0.0001"), rounding=ROUND_HALF_UP)
-    completion = Decimal(completion_tokens) / 1000 * PRICE_PER_1K_TOKENS
-    completion = completion.quantize(Decimal("0.0001"), rounding=ROUND_HALF_UP)
-    return prompt + completion
+    return _tokens_cost(prompt_tokens) + _tokens_cost(completion_tokens)
