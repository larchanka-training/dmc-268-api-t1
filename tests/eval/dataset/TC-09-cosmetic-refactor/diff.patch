+"""Подсчёт сумм заказа."""
+
+from collections.abc import Sequence
 from decimal import Decimal
 
+from app.billing.models import OrderItem
+
+CENT = Decimal("0.01")
+
 
-def calc(items):
-    t = Decimal("0")
-    for i in items:
-        t += i.price * i.qty
-    return t
+def calculate_total(items: Sequence[OrderItem]) -> Decimal:
+    total = Decimal("0")
+    for item in items:
+        total += item.price * item.qty
+    return total
 
 
-def calc_tax(items, rate):
-    return (calc(items) * rate).quantize(Decimal("0.01"))
+def calculate_tax(items: Sequence[OrderItem], rate: Decimal) -> Decimal:
+    return (calculate_total(items) * rate).quantize(CENT)
