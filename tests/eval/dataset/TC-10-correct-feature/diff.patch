@@ -0,0 +1,41 @@
+"""Поиск пользователей по подстроке имени."""
+
+from dataclasses import dataclass
+from typing import Protocol
+
+MAX_LIMIT = 100
+DEFAULT_LIMIT = 20
+
+
+@dataclass(frozen=True, slots=True)
+class UserRow:
+    id: int
+    name: str
+    email: str
+
+
+class Connection(Protocol):
+    def execute(self, sql: str, params: tuple[object, ...]) -> list[tuple[int, str, str]]: ...
+
+
+def escape_like(value: str) -> str:
+    """Экранировать спецсимволы LIKE, чтобы `%` и `_` из ввода искались буквально."""
+    return value.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
+
+
+def search_users(
+    conn: Connection, query: str, *, limit: int = DEFAULT_LIMIT, offset: int = 0
+) -> list[UserRow]:
+    """Пользователи, в имени которых есть `query`, без учёта регистра, по имени и id."""
+    needle = query.strip()
+    if not needle:
+        return []
+    limit = max(1, min(limit, MAX_LIMIT))
+    offset = max(0, offset)
+    rows = conn.execute(
+        "SELECT id, name, email FROM users"
+        " WHERE name ILIKE %s ESCAPE '\\'"
+        " ORDER BY name, id LIMIT %s OFFSET %s",
+        ("%" + escape_like(needle) + "%", limit, offset),
+    )
+    return [UserRow(id=r[0], name=r[1], email=r[2]) for r in rows]
