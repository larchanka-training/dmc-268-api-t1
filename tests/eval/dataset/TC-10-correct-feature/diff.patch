@@ -0,0 +1,38 @@
+from app.users.search import MAX_LIMIT, UserRow, escape_like, search_users
+
+
+class FakeConnection:
+    def __init__(self, rows):
+        self.rows = rows
+        self.calls = []
+
+    def execute(self, sql, params):
+        self.calls.append((sql, params))
+        return self.rows
+
+
+def test_escape_like_escapes_wildcards_and_backslash():
+    assert escape_like("50%_a\\b") == "50\\%\\_a\\\\b"
+
+
+def test_blank_query_does_not_hit_database():
+    conn = FakeConnection([])
+    assert search_users(conn, "   ") == []
+    assert conn.calls == []
+
+
+def test_query_is_passed_as_parameter():
+    conn = FakeConnection([(1, "Анна", "anna@example.com")])
+    result = search_users(conn, " анн ")
+    assert result == [UserRow(id=1, name="Анна", email="anna@example.com")]
+    sql, params = conn.calls[0]
+    assert "анн" not in sql
+    assert params == ("%анн%", 20, 0)
+
+
+def test_limit_and_offset_are_clamped():
+    conn = FakeConnection([])
+    search_users(conn, "a", limit=10_000, offset=-5)
+    assert conn.calls[0][1][1:] == (MAX_LIMIT, 0)
+    search_users(conn, "a", limit=0)
+    assert conn.calls[1][1][1] == 1
