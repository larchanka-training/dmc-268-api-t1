# Образец окружения: скопируйте в .env и заполните. В репозиторий .env не
# попадает (см. .gitignore), реальные значения не коммитим.

# PostgreSQL DSN — обязателен.
DATABASE_URL=postgresql+psycopg://dmc268:dmc268@localhost:5432/dmc268

# Строка подключения AMQP. Пустая — адаптер очереди громко падает при первом
# enqueue, локально хватает сервиса rabbitmq из docker-compose.yml.
RABBITMQ_URL=amqp://dmc268:dmc268@localhost:5672/

# Идентификатор GitHub App (GITHUB_APP_ID).
GITHUB_APP_ID=

# PEM private key GitHub App целиком, с переносами строк
# (GITHUB_APP_PRIVATE_KEY). Секрет: в repr настроек не печатается.
GITHUB_APP_PRIVATE_KEY=

# Секрет HMAC вебхуков GitHub — тот же, что в настройках App
# (GITHUB_WEBHOOK_SECRET). Пустой — эндпоинт отклоняет все вебхуки (401).
GITHUB_WEBHOOK_SECRET=
