# Переменные, которые читает процесс API (app/config.py). Скопируйте в .env,
# он не коммитится.
#
# Для `docker compose up` этот файл не нужен: compose передаёт настройки сам.
# Он нужен, когда API запускается мимо compose — например, uvicorn из IDE
# против базы, поднятой compose'ом.

# DSN PostgreSQL. Префикс +psycopg обязателен: без него SQLAlchemy пойдёт
# в psycopg2, которого в зависимостях нет.
DATABASE_URL=postgresql+psycopg://dmc268:dmc268@localhost:5432/dmc268
