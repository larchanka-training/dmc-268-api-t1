# Переменные, которые читает процесс API (app/config.py). Скопируйте в .env,
# он не коммитится.
#
# Для `docker compose up` этот файл не нужен: compose передаёт настройки сам.
# Он нужен, когда API запускается мимо compose — например, uvicorn из IDE
# против базы, поднятой compose'ом.

# DSN PostgreSQL. Префикс +psycopg обязателен: без него SQLAlchemy пойдёт
# в psycopg2, которого в зависимостях нет.
DATABASE_URL=postgresql+psycopg://dmc268:dmc268@localhost:5432/dmc268

# Строка подключения AMQP — обязательна. Учётка guest/guest — у брокера из
# compose (порт открыт только на 127.0.0.1); прежняя dmc268/dmc268 там не заведена.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Секрет HMAC вебхуков GitHub (GITHUB_WEBHOOK_SECRET). Обязателен: пустой
# отклоняется на старте. local-dev-secret — заглушка для локального стенда, как
# в docker-compose.yml, а не секрет. С настоящей GitHub App поставьте сюда
# webhook secret из её настроек.
GITHUB_WEBHOOK_SECRET=local-dev-secret

# Идентификатор GitHub App (GITHUB_APP_ID). Пустой — вебхуки отвечают 502
# на обращении к VCS, остальное API работает.
GITHUB_APP_ID=

# PEM private key GitHub App целиком, с переносами строк
# (GITHUB_APP_PRIVATE_KEY). Секрет: в repr настроек не печатается.
GITHUB_APP_PRIVATE_KEY=

# Client ID и client secret того же GitHub App — для входа пользователей через
# OAuth (GITHUB_APP_CLIENT_ID, GITHUB_APP_CLIENT_SECRET). Пустые — вход
# отвечает ошибкой провайдера, остальное API работает. Секрет в repr настроек
# не печатается.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=

# Публичный origin, с которого открывают интерфейс, без завершающего `/`
# (PUBLIC_ORIGIN). С ним сверяется заголовок Origin изменяющих запросов, от него
# строится callback входа: <PUBLIC_ORIGIN>/api/v1/auth/github/callback — его же
# регистрируют в настройках GitHub App. Пустой — изменяющие запросы с сессией
# получают 403. Cookie сессии с флагом Secure браузер принимает только по HTTPS
# или на localhost.
PUBLIC_ORIGIN=http://localhost:8000

# Ключ шифрования токенов пользователя GitHub в базе (USER_TOKEN_ENCRYPTION_KEY):
# 32 случайных байта в base64, генерируется `openssl rand -base64 32`. Токен,
# полученный при входе, хранится при сессии только зашифрованным (AES-256-GCM)
# и нужен списку и подключению репозиториев. Пустой — вход отказывает
# (provider_unavailable), битый — API не стартует. Смена ключа делает
# сохранённые токены нечитаемыми: пользователей попросит войти заново.
USER_TOKEN_ENCRYPTION_KEY=
# Пороги выметателя зависших прогонов (воркер), секунды без прогресса.
# Прогресс ждущего в очереди прогона — время создания, поэтому у queued свой
# порог, больше любого разумного хвоста очереди; воркер не стартует, если он
# не больше STALE_RUN_TIMEOUT_SECONDS.
# STALE_RUN_TIMEOUT_SECONDS=1800
# QUEUED_RUN_TIMEOUT_SECONDS=21600
# Повтор упавших доставок вебхука (воркер): GitHub сам их не повторяет. Без
# GITHUB_APP_ID и GITHUB_APP_PRIVATE_KEY повтор выключен. Пауза перед
# переотправкой растёт вдвое с каждой попыткой; доставка pull_request, чей
# коммит уже не голова PR, не переотправляется.
# WEBHOOK_REDELIVERY_ENABLED=true
# WEBHOOK_REDELIVERY_INTERVAL_SECONDS=300
# WEBHOOK_REDELIVERY_MAX_ATTEMPTS=5
# WEBHOOK_REDELIVERY_BACKOFF_SECONDS=300
# WEBHOOK_REDELIVERY_MAX_PER_PASS=10
# WEBHOOK_REDELIVERY_PASS_BUDGET_SECONDS=30
# Потолки тела запроса API: большее тело — 413 REQUEST_BODY_TOO_LARGE до чтения целиком и до
# подписи вебхука. Вебхук — 2 МиБ, с запасом над доставками pull_request и
# pull_request_review_thread; остальные ручки — 1 МиБ. client_max_body_size в location /api/
# nginx фронта (dmc-268-ui-t1, nginx/site.conf) не меньше WEBHOOK_BODY_MAX_BYTES.
# WEBHOOK_BODY_MAX_BYTES=2097152
# REQUEST_BODY_MAX_BYTES=1048576
# Лимиты сборки контекста прогона (воркер). Значения по умолчанию — в
# app/config.py; раскомментируйте, чтобы переопределить.
# CONTEXT_MAX_TOKENS=32000
# Больший дифф PR не дочитывается и не ревьюится: прогон failed с DIFF_TOO_LARGE.
# DIFF_MAX_BYTES=5242880
# RULES_MAX_TOKENS=4000
# RULES_MAX_BYTES=32768
# RULES_CACHE_TTL_SECONDS=3600
# Сколько API помнит, какие репозитории пользователь видит на GitHub; отзыв доступа виден с этой задержкой.
# VISIBLE_REPOSITORIES_CACHE_TTL_SECONDS=30
# AST_MAX_FILES=20
# AST_MAX_FILE_BYTES=262144
# Доля пакета под заголовок, описание и сообщения коммитов PR.
# PR_CONTEXT_MAX_TOKENS=1000

# Окно модели и резерв в нём под ответ (воркер). Окно - наименьшее из окон
# настроенных моделей; пакет контекста, системный промпт и резерв обязаны
# в него помещаться.
# LLM_CONTEXT_WINDOW_TOKENS=65536
# LLM_MAX_OUTPUT_TOKENS=4096

# Адаптер модели воркера (LLM_BACKEND): stub - без похода к модели, ollama -
# локальная модель, eurorouter - hosted-провайдер основным (нужны EUROROUTER_*
# ниже, код проверяемых репозиториев уходит ему). Не задан - воркер не стартует: заглушка выбирается только
# явно. docker compose берёт значения отсюда же.
LLM_BACKEND=stub
# OLLAMA_BASE_URL=http://ollama:11434
# Обязательна при LLM_BACKEND=ollama; подтянуть модель:
# docker compose --profile ollama exec ollama ollama pull qwen2.5-coder:7b
# OLLAMA_MODEL=qwen2.5-coder:7b

# Eurorouter - hosted-провайдер: основной при LLM_BACKEND=eurorouter или
# фоллбэк после локальной модели при LLM_HOSTED_FALLBACK=true. Включение отправляет код проверяемых
# репозиториев за пределы нашей сети. Ключи - через запятую, секрет.
# LLM_HOSTED_FALLBACK=false
# EUROROUTER_BASE_URL=
# EUROROUTER_MODEL=
# EUROROUTER_API_KEYS=

# Попыток получить ответ по схеме у одного провайдера и таймаут HTTP-запроса.
# LLM_MAX_ATTEMPTS=2
# LLM_TIMEOUT_SECONDS=300

# Трассировка OpenTelemetry (API и воркер). По умолчанию спаны никуда не
# уходят: trace id есть (`X-Trace-ID`), экспорта нет. console - печатать спаны
# в stdout для отладки; другие экспортёры (otlp) пока не поддержаны - #89.
# OTEL_TRACES_EXPORTER=console
# Имя сервиса в спанах; по умолчанию dmc-268-api и dmc-268-worker.
# OTEL_SERVICE_NAME=
# Стабильные имена атрибутов semconv у спанов SQL и httpx (`db.query.text`,
# `http.request.method`, `url.full`). Не задана - код ставит database,http сам;
# заданное значение не перетирается.
# OTEL_SEMCONV_STABILITY_OPT_IN=database,http
