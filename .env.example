# Переменные, которые читает процесс API (app/config.py). Скопируйте в .env,
# он не коммитится.
#
# Для `docker compose up` этот файл не нужен: compose передаёт настройки сам.
# Он нужен, когда API запускается мимо compose — например, uvicorn из IDE
# против базы, поднятой compose'ом.

# DSN PostgreSQL. Префикс +psycopg обязателен: без него SQLAlchemy пойдёт
# в psycopg2, которого в зависимостях нет.
DATABASE_URL=postgresql+psycopg://dmc268:dmc268@localhost:5432/dmc268

# Строка подключения AMQP — обязательна: без неё стартует только воркер,
# который всё равно не обработает ни одной задачи.
RABBITMQ_URL=amqp://dmc268:dmc268@localhost:5672/

# Секрет HMAC вебхуков GitHub — тот же, что в настройках App
# (GITHUB_WEBHOOK_SECRET). Обязателен: пустой отклоняется на старте.
GITHUB_WEBHOOK_SECRET=

# Идентификатор GitHub App (GITHUB_APP_ID). Пустой — вебхуки отвечают 502
# на обращении к VCS, остальное API работает.
GITHUB_APP_ID=

# PEM private key GitHub App целиком, с переносами строк
# (GITHUB_APP_PRIVATE_KEY). Секрет: в repr настроек не печатается.
GITHUB_APP_PRIVATE_KEY=

# Лимиты сборки контекста прогона (воркер). Значения по умолчанию — в
# app/config.py; раскомментируйте, чтобы переопределить.
# CONTEXT_MAX_TOKENS=32000
# RULES_MAX_TOKENS=4000
# RULES_MAX_BYTES=32768
# RULES_CACHE_TTL_SECONDS=3600
# AST_MAX_FILES=20
# AST_MAX_FILE_BYTES=262144
# Доля пакета под заголовок, описание и сообщения коммитов PR.
# PR_CONTEXT_MAX_TOKENS=1000

# Окно модели и резерв в нём под ответ (воркер). Окно - наименьшее из окон
# настроенных моделей; пакет контекста, системный промпт и резерв обязаны
# в него помещаться.
# LLM_CONTEXT_WINDOW_TOKENS=65536
# LLM_MAX_OUTPUT_TOKENS=4096

# Адаптер модели воркера (LLM_BACKEND): stub - без похода к модели, ollama -
# локальная модель. Не задан - воркер не стартует. docker compose берёт
# значения отсюда же; по умолчанию у него stub.
# LLM_BACKEND=stub
# OLLAMA_BASE_URL=http://ollama:11434
# Обязательна при LLM_BACKEND=ollama; подтянуть модель:
# docker compose --profile ollama exec ollama ollama pull qwen2.5-coder:7b
# OLLAMA_MODEL=qwen2.5-coder:7b

# Eurorouter - hosted-провайдер, только фоллбэк после локальной модели и
# только при LLM_HOSTED_FALLBACK=true. Включение отправляет код проверяемых
# репозиториев за пределы нашей сети. Ключи - через запятую, секрет.
# LLM_HOSTED_FALLBACK=false
# EUROROUTER_BASE_URL=
# EUROROUTER_MODEL=
# EUROROUTER_API_KEYS=

# Попыток получить ответ по схеме у одного провайдера и таймаут HTTP-запроса.
# LLM_MAX_ATTEMPTS=2
# LLM_TIMEOUT_SECONDS=300
