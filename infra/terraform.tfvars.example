# Пример для локального запуска. В CI этих значений нет: там переменные
# приходят через TF_VAR_* из секретов, а terraform.tfvars не существует.
#
# Важно: с появлением backend.tf локальный `tofu apply` перестал быть
# самодостаточным — состояние лежит в хранилище на сервере, и к нему нужен
# туннель плюс учётные данные. Подробности в README.md.

# --- обязательные (без них apply не стартует) ---

# Ссылка на образ API с digest; тег без digest не пройдёт проверку. В CI —
# тег по commit sha и digest из сборки. Digest опубликованного образа:
# `docker buildx imagetools inspect <образ>:<тег>`, строка Digest.
api_image         = "ghcr.io/larchanka-training/dmc-268-api-t1:CHANGE_ME_TAG@sha256:CHANGE_ME_64_HEX"
postgres_password = "CHANGE_ME_POSTGRES"
rabbitmq_password = "CHANGE_ME_RABBITMQ"
# Секрет подписи вебхуков GitHub App; пустой не пройдёт проверку.
github_webhook_secret = "CHANGE_ME_WEBHOOK"
# Ключ шифрования токенов пользователя: `openssl rand -base64 32`.
user_token_encryption_key = "CHANGE_ME_openssl_rand_base64_32_xxxxxxxxx="
# Адаптер модели воркера, значения по умолчанию нет: stub - без похода к
# модели, ollama - локальная модель (тогда обязателен ollama_model).
llm_backend = "stub"

# --- учётные данные реестра образов ---
# В CI — github.actor и GITHUB_TOKEN, живущие один прогон. Локально нужны
# только если образ лежит в приватном пакете.
registry_username = ""
registry_password = ""

# --- остальное имеет значения по умолчанию ---

docker_host      = "unix:///var/run/docker.sock"
bind_ip          = "127.0.0.1"
internal_bind_ip = "127.0.0.1"
service_host     = "127.0.0.1"
api_port         = 8000
postgres_user    = "dmc268"
postgres_db      = "dmc268"
postgres_port    = 5432
rabbitmq_user    = "dmc268"
rabbitmq_port    = 5672

# --- модель воркера ---
# Eurorouter включается только фоллбэком после локальной модели:
# llm_hosted_fallback = true требует llm_backend = "ollama" и всех eurorouter_*
# и отправляет код проверяемых репозиториев hosted-провайдеру. Ключи - через
# запятую, в CI из секрета.
ollama_model        = ""
llm_hosted_fallback = false

# --- GitHub App ---
# Без них apply пройдёт, но VCS-шлюз и вход пользователей не заработают
# (README.md, «Деплой»).
# github_app_id            = ""
# github_app_private_key   = ""
# github_app_client_id     = ""
# github_app_client_secret = ""
# public_origin            = "https://<адрес интерфейса>"
