# Сети стека: три вместо одной общей — каждый контейнер видит только тех, с
# кем говорит (спека backend-delivery, «Сети стека разделены по назначению»).

# Сеть публичного входа: интерфейс и API. Имя не менять: по нему к сети
# подключается стек репозитория dmc-268-ui-t1.
resource "docker_network" "dmc268" {
  name = "dmc268"
}

# Сеть данных: база, реплика, брокер и те, кто с ними работает. internal — у
# сети нет шлюза: из неё не выйти в интернет, а интерфейс в неё не подключён,
# поэтому база и брокер недоступны ни снаружи, ни с публичного входа.
# Публиковать порт с такой сети Docker не умеет, поэтому у базы и брокера
# портов на хосте нет: отладка — через `docker exec`.
resource "docker_network" "backend" {
  name     = "dmc268-backend"
  internal = true
}

# Исходящая сеть воркера: GitHub API и провайдер модели. Отдельно от сети
# входа, чтобы воркер не был виден интерфейсу; портов воркер не публикует.
resource "docker_network" "egress" {
  name = "dmc268-egress"
}

# Сеть приёма трейсов браузера: коллектор и интерфейс. nginx интерфейса
# проксирует `/otlp/v1/traces` на OTLP/HTTP коллектора (dmc268-otelcol:4318),
# поэтому кабинет шлёт трейсы на свой же origin. Отдельная сеть, а не dmc268:
# в dmc268 у коллектора был бы выход в интернет, а интерфейс видел бы его
# соседей. internal — шлюза нет. Создаётся без флага стека: к ней по имени
# подключается стек dmc-268-ui-t1, и его data source не должен падать на
# стенде без observability_enabled. Имя не менять.
resource "docker_network" "otlp" {
  name     = "dmc268-otlp"
  internal = true
}
